# Copy this file to .env and fill in the values.
API_PORT=4000
# Origin of the Vite frontend, allowed by CORS
CLIENT_ORIGIN=http://localhost:3000

# SQLite file for local development (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Folder where uploaded images are stored (relative to server/)
UPLOAD_DIR=uploads


# Already installed local vision model; the app never downloads models.
OLLAMA_MODEL=qwen3-vl:4b
